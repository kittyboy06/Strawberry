# 🍓 Strawberry Universal Environment Configuration
# Copy this file to .env at the repository root to configure both CLI and Admin Web App:
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# 1. Supabase Cloud Configuration (New Publishable & Secret Key Architecture)
# ─────────────────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Find these in Project Settings -> API:
STRAWBERRY_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable Key (Starts with sb_publishable_...) - Safe for public client apps & student CLI
STRAWBERRY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret Key (Starts with sb_secret_...) - Privileged access for backend workers/publishing
STRAWBERRY_SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Alternate Vite prefixes (automatically supported):
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# (Legacy anon key prefix also supported for backward compatibility)
# STRAWBERRY_SUPABASE_ANON_KEY=...

# ─────────────────────────────────────────────────────────────────────────────
# 2. Strawberry CLI Runtime & Timer Settings
# ─────────────────────────────────────────────────────────────────────────────
# Input countdown duration per selection screen (in seconds, default: 7.0)
STRAWBERRY_INPUT_TIMEOUT_SECONDS=7.0

# Network timeout for remote HTTP requests during sync (in seconds, default: 10.0)
STRAWBERRY_NETWORK_TIMEOUT_SECONDS=10.0

# Background daemon polling interval to check for updates (in seconds, default: 240 / 4 minutes)
STRAWBERRY_DAEMON_POLL_INTERVAL_SECONDS=240
